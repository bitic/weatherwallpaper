[Unit]
Description=ECMWF IFS Weather Wallpaper Generator Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/pquintana/projectes/weatherwallpaper
Environment=PYTHONUNBUFFERED=1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=/home/pquintana/projectes/weatherwallpaper/.venv/bin/python /home/pquintana/projectes/weatherwallpaper/generate_wallpaper.py

[Install]
WantedBy=default.target
